  "texts": {
    "offline_title": "山中无甲子",
    "offline_body_std": "你离山 {duration}，弟子们不敢懈怠：灵气 +{qi}，修为 +{xiufu}，灵石 +{lingshi}，丹药 +{danyao}。离山之人道心有旁骛，所获折半；护山阵荫庇，效率 +{bonus}。",
    "offline_body_capped": "你这一去太久，山中灵气攒到 {cap_duration} 就满了，再多的随风散去。灵气 +{qi}，修为 +{xiufu}，灵石 +{lingshi}，丹药 +{danyao}。封顶 {cap_hours} 个时辰——常回来看看山。",
    "offline_body_tiny": "不过转身倒茶的工夫，山中一切如旧。",
    "offline_capped_hint": "闭关已至八时辰之限，再久灵机涣散",
    "rebirth_first_hint": "你隐约窥见轮回门径：兵解转世，来世可携传承重修。",
    "rebirth_panel_title": "兵解 · 转世",
    "rebirth_panel_quote": "肉身如舟，渡到此岸便够了。",
    "rebirth_confirm": "轮回一开，此世灵气、灵石、丹药、修为、建筑、境界尽数归尘（丹毒也随之消散）；传承点、传承加成、道心、图鉴、碑林与隔世故人随行。确定转世？",
    "rebirth_after_log": "你又在上次醒来的地方醒来。有些东西，跟着你一起回来了。",
    "event_forewarn": "远处隐有异动…",
    "event_leave": "离去",
    "tutorial": [
      "吐纳：连点或按住可加快吐纳。修为是突破的门槛，突破则境界、灵石两开花。",
      "建筑：随时间自动产出。先买便宜的把产出滚起来，永远别让灵石闲着。",
      "奇遇：约每炷香上门，三选一。「离去」永远安全——但故事都是选出来的人才有。"
    ],
    "guide_by_realm": [
      "点「吐纳」攒灵气修为，先买吐纳法和灵田——修为满一百五十，点金色突破。",
      "炼丹炉和坊市解锁了：丹药能临时翻倍产量，坊市开始给你赚灵石。",
      "剑冢加修为、药园加炼丹速度。从这层起冲关有失败率——怕疼就选「稳扎稳打」。",
      "藏经阁全局增产、护山阵提升离线收益。丹药攒到五颗会自动服用。",
      "转生解锁了！右栏「转生」可兵解转世：修为换传承点，买永久加成，下一世飞快。",
      "洞府大幅加速修为。卡关太久会有顿悟或心魔——道心是善是恶，看你的选择。",
      "诛仙剑阵是压箱底的大杀器，全局产量猛增。灵石紧张就多升坊市。",
      "大乘之后仙品奇遇更多。当年结下的因果，故人可能陆续上门——恩怨都有回响。",
      "渡劫了！天劫池事件高风险高回报。突破飞升后，本世山志将刻入碑林。",
      "一世圆满。兵解转世吧——传承、碑林、隔世的故人都跟着你，再修一世。"
    ],
    "hints": {
      "first_max_xp": "修为已攒满——点中央下方的金色「突破」即可破境（突破会清零修为，重新积累）。",
      "first_pill_stock": "丹房开张：顶栏「丹房」可查库存与丹毒。同种丹从低品质先服，好丹留着关键时刻。",
      "first_toxic": "丹毒积身了：每 10 点产量降一截，会随时间消散，「清心丹」可大幅化解——劣品丹少吃。",
      "first_visitor": "故人上门：当年的选择有了回响。恩人护法、仇人搅局——怎么应对，看你。",
      "first_buff": "灵机入体：顶栏这枚标记是限时增益，倒计时走完便散，抓紧用。",
      "first_rebirth_ready": "化神已至：右栏「转生」点亮。兵解转世——修为换传承点，买永久加成，下一世快得多。",
      "first_fail": "突破失败别慌：连败 3 次必定成功，修为保留一半，稳扎稳打更稳。",
      "first_insight": "顿悟：卡关太久山灵自会点拨——白得的修为，继续。",
      "first_xinmo": "心魔：产量暂时受损，会自己散去；道心高的人少遇心魔。"
    }
